  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product image",
      "info": "PNG with transparent background recommended (800×800px+). When set, replaces the CSS speaker with your actual product photo."
    },
    {
      "type": "header",
      "content": "Branding"
    },
    {
      "type": "image_picker",
      "id": "store_logo",
      "label": "Store logo",
      "info": "White / light-coloured logo. Shown in the end card."
    },
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Main headline",
      "default": "Transform Your Shower Experience"
    },
    {
      "type": "text",
      "id": "sub_headline",
      "label": "Sub-headline",
      "default": "Premium Sound. Anywhere."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA button text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA button link"
    },
    {
      "type": "header",
      "content": "Behaviour"
    },
    {
      "type": "checkbox",
      "id": "autoplay_loop",
      "label": "Loop animation automatically",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Hero Cinematic Intro"
    }
  ]
}
